                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox13">
                          <rd:DefaultName>Textbox13</rd:DefaultName>
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=iif(Fields!MISSDAY.Value&gt;0,"MISSED",iif(Fields!REMIND.Value&gt;0 and Fields!PCHST_EFF_DT.Value is nothing,"REMIND",iif(Fields!PCHST_EFF_DT.Value is nothing,"FUTURE","PAYMENT")))</Value>
                                  <Style>
                                    <FontFamily>Arial</FontFamily>
                                    <FontSize>9pt</FontSize>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Color>#92846e</Color>
                              <Style>Solid</Style>
