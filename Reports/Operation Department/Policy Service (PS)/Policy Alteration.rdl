    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <CommandText>SELECT TITLE, TYPE_VALUE FROM dropdown_setup
WHERE dropdown_setup.type_value = 'al request type'
UNION 
SELECT ' All' AS TITLE, 'al request type' as type_value</CommandText>
      </Query>
      <Fields>
        <Field Name="title">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>TITLE</DataField>
        </Field>
        <Field Name="type_value">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>TYPE_VALUE</DataField>
        </Field>
      </Fields>
    </DataSet>
