  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource1</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FromDate">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!FromDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ToDate">
            <rd:UserDefined>true</rd:UserDefined>
            <Value>=Parameters!ToDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@RequestType">
            <Value>=Parameters!RequestType.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>IF @RequestType = ' All'
SELECT ra.*, AGT_INFO.AGENT_TYPE as agent_position FROM request_alteration ra
LEFT JOIN DLIUDW01.DLKHSTAGE.dbo.DMS_AGENT_DETAIL AGT_INFO ON ra.agent_id = CAST(AGT_INFO.AGENT_CODE AS VARCHAR)
WHERE ra.case_received_date BETWEEN @FromDate AND @ToDate
ELSE
SELECT ra.*, AGT_INFO.AGENT_TYPE as agent_position FROM request_alteration ra
LEFT JOIN DLIUDW01.DLKHSTAGE.dbo.DMS_AGENT_DETAIL AGT_INFO ON ra.agent_id = CAST(AGT_INFO.AGENT_CODE AS VARCHAR)
WHERE ra.case_received_date BETWEEN @FromDate AND @ToDate
AND ra.request_type = @RequestType</CommandText>
      </Query>
