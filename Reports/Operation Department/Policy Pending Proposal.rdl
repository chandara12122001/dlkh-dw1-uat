    <DataSet Name="FailedSTPCode">
      <Query>
        <DataSourceName>STP</DataSourceName>
        <CommandText>SELECT  
    r.application_number, 
    r.policy_number,
    STRING_AGG(rd.rule_code || ':' || rd.rule_result_code, ',') AS rule_codes
FROM 
    "result" r 
LEFT JOIN 
    result_detail rd 
    ON rd.result_id = r.id 
GROUP BY 
    r.application_number, 
    r.policy_number</CommandText>
      </Query>
      <Fields>
        <Field Name="application_number">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>application_number</DataField>
        </Field>
        <Field Name="policy_number">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>policy_number</DataField>
        </Field>
        <Field Name="rule_codes">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>rule_codes</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
