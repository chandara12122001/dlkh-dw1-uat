                                <TextRun>
                                  <Value>Cut-off by Dispatch Date :  </Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <Format>yyyy-MM-dd hh:mm:ss tt</Format>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Label>START_DATE</Label>
                                  <Value>=IIF(IsNothing(Parameters!start_date.Value),"Early", Parameters!start_date.Value)</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <Format>dd/MM/yyyy</Format>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value> - </Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <Format>yyyy-MM-dd hh:mm:ss tt</Format>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Label>END_DATE</Label>
                                  <Value>=IIF(IsNothing(Parameters!end_date.Value),FORMAT(Cdate(today), "dd/MM/yyyy"), Parameters!end_date.Value)</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <Format>dd/MM/yyyy</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                              </Style>
                            </Paragraph>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>Printed : </Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <Format>yyyy-MM-dd hh:mm:ss tt</Format>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Label>PRINT_DATE</Label>
                                  <Value>=Globals!ExecutionTime</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <Format>dd/MM/yyyy hh:mm:ss tt</Format>
                                  </Style>
                                </TextRun>
                                <TextRun>
                                  <Value xml:space="preserve"> </Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Normal</FontWeight>
                                    <Format>yyyy-MM-dd hh:mm:ss tt</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
